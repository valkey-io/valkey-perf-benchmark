[
  {
    "test_name": "Set commands (smoke)",
    "set_matrix": {
      "duration": 6,
      "window": [1, 4],
      "clients": 10,
      "pipelines": [1],
      "ttl_seconds": 100000000,
      "shapes": {
        "listpack16": {
          "members": 16,
          "member_size": 16,
          "encoding": "listpack",
          "encoding_with_ttl": "listpack",
          "toggles": 8,
          "population": 500000
        },
        "listpack128": {
          "members": 128,
          "member_size": 16,
          "encoding": "listpack",
          "encoding_with_ttl": "listpack",
          "toggles": 8,
          "population": 20000,
          "only_mixes": ["none", "exp_all_but_1", "exp_half", "exp_10pct", "exp_one"]
        },
        "intset512": {
          "members": 512,
          "integer": true,
          "encoding": "intset",
          "encoding_with_ttl": "hashtable",
          "toggles": 16,
          "population": 20000,
          "grow_headroom": 64
        },
        "hashtable2k": {
          "members": 2000,
          "member_size": 16,
          "encoding": "hashtable",
          "encoding_with_ttl": "hashtable",
          "toggles": 100,
          "population": 2000
        }
      },
      "ttl_mixes": {
        "none": {},
        "half": {"fraction": 0.5},
        "exp_all_but_1": {"expired": true, "live": 1, "skip_commands": ["spop"]},
        "exp_half": {"expired": true, "fraction": 0.5},
        "exp_10pct": {"expired": true, "fraction": 0.1},
        "exp_one": {"expired": true, "count": 1}
      },
      "commands": {
        "sismember": {"command": "SISMEMBER {key} {member}", "on_expired": true},
        "sismember_expired": {"command": "SISMEMBER {key} {expired_member}", "layout": "expired", "on_expired": true, "expired_only": true},
        "srem_sadd": {"writes": ["SREM {key} {toggle}", "SADD {key} {toggle}"], "layout": "toggle"},
        "spop": {"command": "SPOP {rand_key} 1", "layout": "population", "on_expired": true},
        "smove": {"writes": ["SMOVE {key} {key2} {toggle}", "SMOVE {key2} {key} {toggle}"], "layout": "two_toggle"},
        "sunionstore": {"command": "SUNIONSTORE {dest} {key} {key2}", "layout": "overlap", "on_expired": true},
        "sexpire": {"command": "SEXPIRE {key} {ttl} MEMBERS 1 {toggle}", "layout": "toggle", "toggle_ttl": true, "requires": ["SEXPIRE"]},
        "saddex_new": {"command": "SADDEX {rand_key} EX {ttl} MEMBERS 1 {new_member}", "layout": "population", "grows": true, "adds_ttl": true, "requires": ["SADDEX"]},
        "sttl": {"command": "STTL {key} MEMBERS 1 {member}", "requires": ["STTL"]}
      }
    },
    "per_second_sampling": {"sources": {"valkey_info": {}}},
    "custom-server-configs": {"maxmemory-policy": "noeviction", "enable-debug-command": "local"},
    "port": 6379,
    "cluster_mode": false,
    "tls_mode": false
  }
]
