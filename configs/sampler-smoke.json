[
  {
    "test_name": "Per-Second Sampler Smoke Test",
    "test_groups": [
      {
        "group": 1,
        "description": "Short SET then GET workload",
        "scenarios": [
          {
            "id": "a",
            "type": "write",
            "description": "SET with 64 byte values over 10k keys",
            "test": "SET",
            "duration": 15,
            "keyspacelen": 10000,
            "data_size": 64,
            "pipeline": 1,
            "clients": 4
          },
          {
            "id": "b",
            "type": "read",
            "description": "GET over a 10k key keyspace seeded with SET",
            "test": "GET",
            "populate_with": "SET",
            "duration": 15,
            "keyspacelen": 10000,
            "data_size": 64,
            "pipeline": 1,
            "clients": 4
          }
        ]
      }
    ],
    "port": 6379,
    "cluster_mode": false,
    "tls_mode": false,
    "per_second_sampling": true
  }
]
